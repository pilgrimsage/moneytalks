<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="moneytalks_test"/>
        <env name="DB_USERNAME" value="moneytalks"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="WHATSAPP_PROVIDER" value="fake"/>
        <env name="WHATSAPP_HANDLER" value="App\Services\WhatsApp\Handlers\AcknowledgeHandler"/>
        <env name="AI_PRIMARY_PROVIDER" value="fake"/>
        <env name="AI_RETRY_BACKOFF_MS" value="0"/>
        <env name="AI_MODEL_FAST" value="claude-haiku-4-5"/>
        <env name="AI_MODEL_STRONG" value=""/>
        <env name="META_APP_SECRET" value="test-app-secret"/>
        <env name="META_PHONE_NUMBER_ID" value="1111111111"/>
        <env name="META_ACCESS_TOKEN" value="test-access-token"/>
        <env name="META_WEBHOOK_VERIFY_TOKEN" value="test-verify-token"/>
        <env name="ALLOWED_WA_IDS" value="919876543210"/>
        <env name="WHATSAPP_PROCESS_AFTER_RESPONSE" value="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
