APP_NAME=MoneyTalks
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-subdomain.example.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Hostinger MySQL/MariaDB (hPanel > Databases)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moneytalks
DB_USERNAME=moneytalks
DB_PASSWORD=

# Database drivers, drained by cron (no Redis, no daemon)
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
DEFAULT_TIMEZONE=Asia/Kolkata

# Chat channel: telegram (recommended: free, no business account) or meta (WhatsApp Cloud API)
WHATSAPP_PROVIDER=telegram

# Telegram: bot token from @BotFather, a random secret (letters/digits/_/- only), and YOUR numeric Telegram user id
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API (only if WHATSAPP_PROVIDER=meta)
META_APP_ID=
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
# Comma-separated ids allowed to use the bot: your numeric Telegram user id (e.g. 424242424) or WhatsApp number (e.g. 919876543210)
ALLOWED_WA_IDS=

# AI
AI_PRIMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-4-5

# Speech-to-text for voice notes (none = voice disabled)
STT_PROVIDER=none
STT_API_KEY=

# Secrets: 64 hex chars each (php -r "echo bin2hex(random_bytes(32));")
PII_BLIND_INDEX_KEY=
BACKUP_ENCRYPTION_KEY=
HEALTH_TOKEN=
