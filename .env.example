APP_NAME=MoneyTalks
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-subdomain.example.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Hostinger MySQL/MariaDB (hPanel > Databases)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moneytalks
DB_USERNAME=moneytalks
DB_PASSWORD=

# Database drivers, drained by cron (no Redis, no daemon)
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
DEFAULT_TIMEZONE=Asia/Kolkata

# ---- Chat channel: set ONE of these, the rest is ignored. To switch later, change this line and fill that channel's section. ----
#   telegram = Telegram Bot API (free, no business account)   |   meta = WhatsApp Cloud API   |   fake = local tests only
WHATSAPP_PROVIDER=telegram

# Who may use the bot (digits only). Each channel has its own list: a Telegram id and a WhatsApp number are different users with separate books.
# ALLOWED_TELEGRAM_IDS: your numeric Telegram user id, e.g. 424242424 (ask @userinfobot); empty = falls back to ALLOWED_WA_IDS
ALLOWED_TELEGRAM_IDS=
# ALLOWED_WA_IDS: your WhatsApp number with country code, no +, e.g. 919876543210
ALLOWED_WA_IDS=

# -- Telegram (WHATSAPP_PROVIDER=telegram) --
# TELEGRAM_BOT_TOKEN: from @BotFather
TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET: random, letters/digits/_/- only: php -r "echo bin2hex(random_bytes(32));"
TELEGRAM_WEBHOOK_SECRET=
# then: php artisan moneytalks:telegram:webhook set

# -- WhatsApp via Meta Cloud API (WHATSAPP_PROVIDER=meta) --
META_APP_ID=
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
# META_ACCESS_TOKEN: permanent System User token (the dashboard one expires in 24 hours)
META_ACCESS_TOKEN=
# META_WEBHOOK_VERIFY_TOKEN: any random string, also entered in Meta's webhook settings
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# AI
AI_PRIMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-4-5

# Speech-to-text for voice notes (none = voice disabled)
STT_PROVIDER=none
STT_API_KEY=

# Secrets: 64 hex chars each (php -r "echo bin2hex(random_bytes(32));")
PII_BLIND_INDEX_KEY=
BACKUP_ENCRYPTION_KEY=
HEALTH_TOKEN=
